+unsigned int uvc_num_urbs(const struct uvc_streaming *stream)
+{
+	const struct usb_device *udev = stream->dev->udev;
+	u8 interface = stream->intf->cur_altsetting->desc.bInterfaceNumber;
+
+	if (le16_to_cpu(udev->descriptor.idVendor) == 0x2bc5 &&
+	    le16_to_cpu(udev->descriptor.idProduct) == 0x06a8 &&
+	    (interface == 1 || interface == 3))
+		return uvc_scancraft_urbs;
+	return UVC_URBS;
+}

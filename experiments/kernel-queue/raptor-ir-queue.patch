+
+/* Diagnostic queue-depth override: original Raptor IR endpoints only. */
+unsigned int uvc_scancraft_urbs = UVC_URBS;
+static bool uvc_scancraft_urbs_frozen;
+
+static int uvc_scancraft_urbs_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int count;
+	int ret;
+
+	/* Active queue sizes must never change during stream lifetime. */
+	if (uvc_scancraft_urbs_frozen)
+		return -EPERM;
+	ret = kstrtouint(val, 0, &count);
+	if (ret || count < UVC_URBS || count > UVC_MAX_URBS)
+		return -EINVAL;
+	*(unsigned int *)kp->arg = count;
+	return 0;
+}
+
+static const struct kernel_param_ops uvc_scancraft_urbs_ops = {
+	.set = uvc_scancraft_urbs_set,
+	.get = param_get_uint,
+};
+module_param_cb(scancraft_urbs, &uvc_scancraft_urbs_ops, &uvc_scancraft_urbs, 0444);
+MODULE_PARM_DESC(scancraft_urbs,
+	"Original Raptor IR URB queue depth, load-time only (5-32, default 5)");
 

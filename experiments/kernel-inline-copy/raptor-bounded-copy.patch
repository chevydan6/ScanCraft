+/*
+ * Experimental bounded copy in the completion context. Preserve the reference
+ * acquired by decode_data, release it exactly once after copying, and reuse the
+ * existing atomic resubmit path. Everything outside this narrow gate stays on
+ * the original workqueue. This bounds copied bytes, not elapsed IRQ time.
+ */
+static void uvc_video_try_inline_copy(struct uvc_urb *uvc_urb)
+{
+	struct uvc_streaming *stream = uvc_urb->stream;
+	const struct usb_device *udev = stream->dev->udev;
+	struct urb *urb = uvc_urb->urb;
+	struct uvc_copy_op *op;
+	u8 interface = stream->intf->cur_altsetting->desc.bInterfaceNumber;
+
+	if (!uvc_scancraft_inline_copy ||
+	    le16_to_cpu(udev->descriptor.idVendor) != 0x2bc5 ||
+	    le16_to_cpu(udev->descriptor.idProduct) != 0x06a8 ||
+	    (interface != 1 && interface != 3) ||
+	    stream->type != V4L2_BUF_TYPE_VIDEO_CAPTURE ||
+	    !usb_pipebulk(urb->pipe) || !usb_pipein(urb->pipe) ||
+	    urb->actual_length <= 0 ||
+	    urb->actual_length > urb->transfer_buffer_length ||
+	    urb->transfer_buffer_length > 12288 ||
+	    uvc_urb->async_operations != 1)
+		return;
+
+	op = &uvc_urb->copy_operations[0];
+	if (op->len > urb->actual_length)
+		return;
+
+	memcpy(op->dst, op->src, op->len);
+	uvc_queue_buffer_release(op->buf);
+	uvc_urb->async_operations = 0;
+}
+
 static void uvc_video_complete(struct urb *urb)
 {
 	struct uvc_urb *uvc_urb = urb->context;
